# shortcut-catcher environment file template.
#
# Copy this file to `.env` and set only what you need. Every value here can
# also be given on the command line or in the run configuration file.
#
# DO NOT commit your filled-in `.env`; `.gitignore` excludes it.

# --- Output ---
# Default directory for run outputs (overridden by --output-dir).
# SHORTCUT_CATCHER_OUTPUT_DIR=./runs

# --- Text backend (optional [text] extra) ---
# Hugging Face cache directory for the ELECTRA weights downloaded on first use.
# HF_HOME=/path/to/huggingface-cache
